# Non-sensitive local defaults. Copy to .env only when an override is needed.
# Production must replace every *_PASSWORD / *_SECRET value and use external OTP.
NODE_ENV=development
SEVO_RUNTIME_ENV=development
API_PORT=3201
WORKER_PORT=3202
PORT=3200
WEB_ORIGIN=http://localhost:3200
API_BASE_URL=http://127.0.0.1:3201
API_READINESS_URL=http://127.0.0.1:3201/health/ready
DATABASE_URL=postgresql://sevo:sevo_local@localhost:6432/sevo
OTP_PROVIDER=dev
DEV_OTP_TEST_MOBILES=09123456789
POSTGRES_DB=sevo
POSTGRES_USER=sevo
POSTGRES_PASSWORD=sevo_local
MINIO_ROOT_USER=sevo_local
MINIO_ROOT_PASSWORD=sevo_local_password
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sevo_local
MINIO_SECRET_KEY=sevo_local_password
MINIO_BUCKET=sevo-media
WEB_HOST_PORT=3100
API_HOST_PORT=3101
POSTGRES_HOST_PORT=6432
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
OTEL_EXPORTER_OTLP_ENDPOINT=
