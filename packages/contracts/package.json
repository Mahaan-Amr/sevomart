{
  "name": "@sevo/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "default": "./dist/health.js"
    },
    "./identity-access/v1": {
      "types": "./dist/identity-access-v1.d.ts",
      "default": "./dist/identity-access-v1.js"
    },
    "./store/v1": {
      "types": "./dist/store-v1.d.ts",
      "default": "./dist/store-v1.js"
    },
    "./media/v1": {
      "types": "./dist/media-v1.d.ts",
      "default": "./dist/media-v1.js"
    },
    "./api-errors/v1": {
      "types": "./dist/api-errors-v1.d.ts",
      "default": "./dist/api-errors-v1.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
