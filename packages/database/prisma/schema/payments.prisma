// Tables in this file are owned by the payments module.

model PaymentAttempt {
  id                String   @id @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  identityId        String   @map("identity_id") @db.Uuid
  status            String   @db.VarChar(24)
  amount            BigInt
  currency          String   @default("IRR") @db.Char(3)
  provider          String   @db.VarChar(24)
  providerReference String?  @unique @map("provider_reference") @db.VarChar(128)
  redirectUrl       String?  @map("redirect_url") @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  dispatchedAt      DateTime? @map("dispatched_at") @db.Timestamptz(3)
  dispatchLeaseUntil DateTime? @map("dispatch_lease_until") @db.Timestamptz(3)
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(3)
  reconciliationCount Int     @default(0) @map("reconciliation_count")
  nextReconciliationAt DateTime? @map("next_reconciliation_at") @db.Timestamptz(3)
  reviewStartedAt    DateTime? @map("review_started_at") @db.Timestamptz(3)

  @@index([orderId])
  @@map("payment_attempts")
}

model PaymentOperationalAlert {
  id            String   @id @db.Uuid
  attemptId     String   @map("attempt_id") @db.Uuid
  kind          String   @db.VarChar(48)
  severity      String   @default("CRITICAL") @db.VarChar(16)
  status        String   @default("OPEN") @db.VarChar(16)
  correlationId String   @map("correlation_id") @db.VarChar(128)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([attemptId, kind])
  @@index([status, createdAt])
  @@map("payment_operational_alerts")
}

model PaymentIdempotencyRecord {
  identityId String   @map("identity_id") @db.Uuid
  key        String   @db.VarChar(200)
  requestHash String  @map("request_hash") @db.Char(64)
  attemptId  String   @map("attempt_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([identityId, key])
  @@map("payment_idempotency_records")
}

model PaymentProviderObservation {
  provider           String   @db.VarChar(24)
  providerEventId    String   @map("provider_event_id") @db.VarChar(128)
  attemptId          String   @map("attempt_id") @db.Uuid
  providerReference  String   @map("provider_reference") @db.VarChar(128)
  result             String   @db.VarChar(24)
  observedAt         DateTime @default(now()) @map("observed_at") @db.Timestamptz(3)
  correlationId      String   @map("correlation_id") @db.VarChar(128)

  @@id([provider, providerEventId])
  @@map("payment_provider_observations")
}

model PaymentAttemptAudit {
  id            String   @id @db.Uuid
  attemptId     String   @map("attempt_id") @db.Uuid
  fromStatus    String?  @map("from_status") @db.VarChar(24)
  toStatus      String   @map("to_status") @db.VarChar(24)
  reasonCode    String   @map("reason_code") @db.VarChar(64)
  actorKind     String   @map("actor_kind") @db.VarChar(32)
  correlationId String   @map("correlation_id") @db.VarChar(128)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([attemptId, occurredAt])
  @@map("payment_attempt_audits")
}

model PaymentDirectRefund {
  orderId           String   @id @map("order_id") @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  paymentAttemptId  String   @map("payment_attempt_id") @db.Uuid
  amount            BigInt
  provider          String   @db.VarChar(64)
  status            String   @db.VarChar(24)
  version           Int
  reason             String   @db.VarChar(500)
  evidenceReference String?  @map("evidence_reference") @db.VarChar(200)
  requestedBy       String   @map("requested_by") @db.Uuid
  requestedAt       DateTime @map("requested_at") @db.Timestamptz(3)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([storeId, status, updatedAt])
  @@map("payment_direct_refunds")
}

model PaymentDirectRefundAudit {
  id                String   @id @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  version           Int
  fromStatus        String?  @map("from_status") @db.VarChar(24)
  toStatus          String   @map("to_status") @db.VarChar(24)
  evidenceReference String?  @map("evidence_reference") @db.VarChar(200)
  actorKind         String   @map("actor_kind") @db.VarChar(24)
  actorReference    String   @map("actor_reference") @db.VarChar(200)
  provider          String?  @db.VarChar(64)
  providerEventId   String?  @map("provider_event_id") @db.VarChar(200)
  requestHash       String?  @map("request_hash") @db.Char(64)
  correlationId     String   @map("correlation_id") @db.Uuid
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(3)

  @@unique([orderId, version])
  @@index([orderId, occurredAt])
  @@map("payment_direct_refund_audits")
}

model PaymentDirectRefundIdempotencyRecord {
  operation       String   @db.VarChar(32)
  orderId         String   @map("order_id") @db.Uuid
  scope           String   @db.VarChar(200)
  key             String   @db.VarChar(200)
  requestHash     String   @map("request_hash") @db.Char(64)
  responseJson    Json     @map("response_json") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([operation, orderId, scope, key])
  @@map("payment_direct_refund_idempotency_records")
}
