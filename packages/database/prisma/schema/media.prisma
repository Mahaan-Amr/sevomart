// Tables in this file are owned by the media module.

model MediaAsset {
  id                String         @id @db.Uuid
  ownerIdentityId   String         @map("owner_identity_id") @db.Uuid
  ownerReferenceId  String?        @map("owner_reference_id") @db.Uuid
  purpose           String         @db.VarChar(32)
  originalObjectKey String         @map("original_object_key") @db.VarChar(255)
  originalMimeType  String         @map("original_mime_type") @db.VarChar(32)
  originalSize      Int            @map("original_size")
  originalChecksum  String         @map("original_checksum") @db.Char(64)
  width             Int
  height            Int
  visibility        String         @default("PRIVATE") @db.VarChar(16)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  variants          MediaVariant[]

  @@index([ownerIdentityId, createdAt])
  @@map("media_assets")
}

model MediaVariant {
  id        String     @id @db.Uuid
  mediaId   String     @map("media_id") @db.Uuid
  name      String     @db.VarChar(32)
  objectKey String     @map("object_key") @db.VarChar(255)
  mimeType  String     @map("mime_type") @db.VarChar(32)
  size      Int
  width     Int
  height    Int
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, name])
  @@map("media_variants")
}

model MediaPurchaseExperienceUploadContext {
  id          String   @id @db.Uuid
  identityId  String   @map("identity_id") @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([identityId, orderItemId], map: "media_purchase_experience_context_identity_order_unique")
  @@index([expiresAt], map: "media_purchase_experience_context_expiry_idx")
  @@map("media_purchase_experience_upload_contexts")
}

model MediaPurchaseExperienceUploadIdempotency {
  contextId      String   @map("context_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  requestHash    String   @map("request_hash") @db.Char(64)
  mediaId        String   @map("media_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([contextId, idempotencyKey])
  @@map("media_purchase_experience_upload_idempotency")
}
