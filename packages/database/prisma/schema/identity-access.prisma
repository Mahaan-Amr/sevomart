// Tables in this file are owned by the identity-access module.

model Identity {
  id           String          @id @db.Uuid
  status       String          @default("ACTIVE") @db.VarChar(16)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  loginMethods LoginMethod[]
  sessions     IdentitySession[]
  platformPermissionGrants PlatformPermissionGrant[]

  @@map("identity_identities")
}

model LoginMethod {
  id         String   @id @db.Uuid
  identityId String   @map("identity_id") @db.Uuid
  kind       String   @default("MOBILE") @db.VarChar(16)
  mobile     String   @unique @db.VarChar(11)
  verifiedAt DateTime @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, kind])
  @@map("identity_login_methods")
}

model OtpChallenge {
  id                String    @id @db.Uuid
  mobile            String    @db.VarChar(11)
  codeHash          String    @map("code_hash") @db.VarChar(64)
  providerReference String    @map("provider_reference") @db.VarChar(128)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(3)
  audience          String    @default("PUBLIC") @db.VarChar(24)
  verificationAttempts Int    @default(0) @map("verification_attempts") @db.SmallInt
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([mobile, createdAt])
  @@map("identity_otp_challenges")
}

model PlatformPermissionAudit {
  id                 String   @id @db.Uuid
  identityId         String   @map("identity_id") @db.Uuid
  permission         String   @db.VarChar(64)
  action             String   @db.VarChar(32)
  reason             String   @db.VarChar(500)
  idempotencyKeyHash String   @map("idempotency_key_hash") @db.VarChar(64)
  payloadHash        String   @map("payload_hash") @db.VarChar(64)
  operation          String   @db.VarChar(16)
  actorScope         String   @map("actor_scope") @db.VarChar(16)
  actorKind          String   @map("actor_kind") @db.VarChar(32)
  correlationId      String   @map("correlation_id") @db.Uuid
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(3)

  @@unique([operation, actorScope, idempotencyKeyHash])
  @@map("identity_platform_permission_audit")
}

model IdentitySession {
  id         String    @id @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  identityId String    @map("identity_id") @db.Uuid
  audience   String    @default("PUBLIC") @db.VarChar(16)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, expiresAt])
  @@map("identity_sessions")
}

model SellerApplication {
  id               String   @id @db.Uuid
  identityId       String   @map("identity_id") @db.Uuid
  status           String   @db.VarChar(32)
  currentRevision  Int      @map("current_revision")
  aggregateVersion Int      @map("aggregate_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSubmittedAt  DateTime @map("last_submitted_at") @db.Timestamptz(3)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  revisions        SellerApplicationRevision[]
  decisions        SellerApplicationDecision[]

  @@index([identityId, createdAt])
  @@map("identity_seller_applications")
}

model SellerAccess {
  id         String   @id @db.Uuid
  identityId String   @unique @map("identity_id") @db.Uuid
  status     String   @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("identity_seller_access")
}

model SellerApplicationRevision {
  id                 String            @id @db.Uuid
  applicationId      String            @map("application_id") @db.Uuid
  revision           Int
  applicantName      String            @map("applicant_name") @db.VarChar(80)
  proposedStoreName  String            @map("proposed_store_name") @db.VarChar(80)
  goodsAreaText      String            @map("goods_area_text") @db.VarChar(120)
  currentSalesMethod String            @map("current_sales_method") @db.VarChar(240)
  submittedAt        DateTime          @map("submitted_at") @db.Timestamptz(3)
  application        SellerApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([applicationId, revision])
  @@map("identity_seller_application_revisions")
}

model SellerApplicationDecision {
  id              String            @id @db.Uuid
  applicationId   String            @map("application_id") @db.Uuid
  revision        Int
  aggregateVersion Int             @map("aggregate_version")
  action          String            @db.VarChar(32)
  reasonCode      String            @map("reason_code") @db.VarChar(48)
  publicReason    String            @map("public_reason") @db.VarChar(1000)
  internalNote    String?           @map("internal_note") @db.VarChar(2000)
  requestedFields String[]          @map("requested_fields")
  actorIdentityId String            @map("actor_identity_id") @db.Uuid
  occurredAt      DateTime          @map("occurred_at") @db.Timestamptz(3)
  application     SellerApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, occurredAt])
  @@map("identity_seller_application_decisions")
}

model PlatformPermissionGrant {
  id         String    @id @db.Uuid
  identityId String    @map("identity_id") @db.Uuid
  permission String    @db.VarChar(64)
  grantedAt  DateTime  @map("granted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@map("identity_platform_permission_grants")
}

model PlatformAccessGrant {
  id                     String    @id @db.Uuid
  grantKind              String    @map("grant_kind") @db.VarChar(24)
  subjectIdentityId      String    @map("subject_identity_id") @db.Uuid
  requestedByIdentityId  String    @map("requested_by_identity_id") @db.Uuid
  approvedByIdentityId   String?   @map("approved_by_identity_id") @db.Uuid
  responsibility         String    @db.VarChar(64)
  purposeCode            String?   @map("purpose_code") @db.VarChar(48)
  scope                   Json?     @db.JsonB
  status                  String    @db.VarChar(24)
  controlMode             String    @map("control_mode") @db.VarChar(32)
  singleManagerException Boolean   @default(false) @map("single_manager_exception")
  revision               Int
  expiresAt               DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt               DateTime  @map("created_at") @db.Timestamptz(3)
  activatedAt             DateTime? @map("activated_at") @db.Timestamptz(3)
  revokedAt               DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([subjectIdentityId, status, createdAt])
  @@map("identity_platform_access_grants")
}

model PlatformAccessIdempotency {
  operation       String   @db.VarChar(64)
  actorIdentityId String   @map("actor_identity_id") @db.Uuid
  key             String   @db.VarChar(128)
  payloadHash     String   @map("payload_hash") @db.VarChar(64)
  response        Json?    @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([operation, actorIdentityId, key])
  @@map("identity_platform_access_idempotency")
}

model PlatformAccessAudit {
  id                      String   @id @db.Uuid
  attemptedGrantId        String   @map("grant_id") @db.Uuid
  resolvedGrantId         String?  @map("resolved_grant_id") @db.Uuid
  attemptedResponsibility String?  @map("attempted_responsibility") @db.VarChar(64)
  action                  String   @db.VarChar(48)
  actorIdentityId         String   @map("actor_identity_id") @db.Uuid
  subjectIdentityId       String?  @map("subject_identity_id") @db.Uuid
  scope                   Json?    @db.JsonB
  reasonCode              String   @map("reason_code") @db.VarChar(48)
  reason                  String   @db.VarChar(1000)
  outcome                 String   @db.VarChar(32)
  singleManagerException  Boolean? @map("single_manager_exception")
  correlationId           String   @map("correlation_id") @db.Uuid
  occurredAt              DateTime @map("occurred_at") @db.Timestamptz(3)

  @@index([attemptedGrantId, occurredAt, id])
  @@map("identity_platform_access_audit")
}

model SellerApplicationIdempotency {
  operation    String   @db.VarChar(64)
  actorId      String   @map("actor_id") @db.Uuid
  key          String   @db.VarChar(128)
  payloadHash  String   @map("payload_hash") @db.VarChar(64)
  state        String   @db.VarChar(16)
  response     Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)

  @@id([operation, actorId, key])
  @@map("identity_seller_application_idempotency")
}

model SellerApplicationAudit {
  id                 String   @id @db.Uuid
  actorKind          String   @map("actor_kind") @db.VarChar(24)
  actorIdentityId    String?  @map("actor_identity_id") @db.Uuid
  audience           String   @db.VarChar(24)
  permission         String?  @db.VarChar(64)
  action             String   @db.VarChar(64)
  targetId           String   @map("target_id") @db.Uuid
  result             String   @db.VarChar(24)
  previousStatus     String?  @map("previous_status") @db.VarChar(32)
  nextStatus         String   @map("next_status") @db.VarChar(32)
  previousRevision   Int?     @map("previous_revision")
  nextRevision       Int      @map("next_revision")
  reasonCode         String?  @map("reason_code") @db.VarChar(48)
  correlationId      String   @map("correlation_id") @db.Uuid
  idempotencyKeyHash String   @map("idempotency_key_hash") @db.VarChar(64)
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(3)

  @@index([targetId, occurredAt])
  @@map("identity_seller_application_audit")
}

model SellerApprovalRecovery {
  id                 String    @id @db.Uuid
  applicationId      String    @map("application_id") @db.Uuid
  actorIdentityId    String    @map("actor_identity_id") @db.Uuid
  expectedRevision   Int       @map("expected_revision")
  reasonCode         String    @map("reason_code") @db.VarChar(48)
  publicReason       String    @map("public_reason") @db.VarChar(1000)
  internalNote       String?   @map("internal_note") @db.VarChar(2000)
  correlationId      String    @map("correlation_id") @db.Uuid
  idempotencyKey     String    @map("idempotency_key") @db.VarChar(128)
  payloadHash        String    @map("payload_hash") @db.VarChar(64)
  status             String    @db.VarChar(16)
  attemptCount       Int       @default(0) @map("attempt_count")
  lastAttemptAt      DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([actorIdentityId, idempotencyKey])
  @@index([applicationId, status])
  @@map("identity_seller_approval_recoveries")
}
