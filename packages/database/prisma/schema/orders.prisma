// Tables in this file are owned by the orders module.

model OrderCart {
  id         String          @id @db.Uuid
  storeId    String          @map("store_id") @db.Uuid
  identityId String?         @map("identity_id") @db.Uuid
  status     String          @default("ACTIVE") @db.VarChar(16)
  revision   Int             @default(0)
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @default(now()) @map("updated_at") @db.Timestamptz(3)
  items      OrderCartItem[]
  tokens     OrderCartAccessToken[]

  @@index([identityId, status])
  @@map("order_carts")
}

model OrderCartItem {
  cartId    String    @map("cart_id") @db.Uuid
  variantId String    @map("variant_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  cart      OrderCart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@id([cartId, variantId])
  @@map("order_cart_items")
}

model OrderCartAccessToken {
  id        String    @id @db.Uuid
  cartId    String    @map("cart_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  cart      OrderCart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId, expiresAt])
  @@map("order_cart_access_tokens")
}

model OrderCartIdempotencyRecord {
  operation    String   @db.VarChar(48)
  scope        String   @db.VarChar(128)
  key          String   @db.VarChar(200)
  requestHash  String   @map("request_hash") @db.Char(64)
  responseJson Json     @map("response_json") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([operation, scope, key])
  @@map("order_cart_idempotency_records")
}
