// Tables in this file are owned by the inventory module.

model InventoryLevel {
  variantId String   @id @map("variant_id") @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  onHand    Int      @default(0) @map("on_hand")
  revision  Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([storeId])
  @@map("inventory_levels")
}

model InventoryAdjustment {
  id              String   @id @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  actorIdentityId String   @map("actor_identity_id") @db.Uuid
  reasonCode      String   @map("reason_code") @db.VarChar(32)
  previousOnHand  Int      @map("previous_on_hand")
  nextOnHand      Int      @map("next_on_hand")
  revision        Int
  correlationId   String   @map("correlation_id") @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([variantId, occurredAt])
  @@map("inventory_adjustments")
}

model InventoryReservation {
  id        String                     @id @db.Uuid
  orderId   String                     @unique @map("order_id") @db.Uuid
  storeId   String                     @map("store_id") @db.Uuid
  status    String                     @default("ACTIVE") @db.VarChar(24)
  expiresAt DateTime                   @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  lines     InventoryReservationLine[]

  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

model InventoryReservationLine {
  reservationId String               @map("reservation_id") @db.Uuid
  variantId     String               @map("variant_id") @db.Uuid
  quantity      Int
  reservation   InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@id([reservationId, variantId])
  @@index([variantId])
  @@map("inventory_reservation_lines")
}
