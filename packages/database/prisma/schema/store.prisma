// Tables in this file are owned by the store module.

model Store {
  id                   String                @id @db.Uuid
  name                 String?               @db.VarChar(80)
  slug                 String?               @unique @db.VarChar(48)
  bio                  String?               @db.VarChar(240)
  returnPolicy         String?               @map("return_policy") @db.VarChar(1000)
  settlementKind       String?               @map("settlement_kind") @db.VarChar(16)
  settlementStatus     String?               @map("settlement_status") @db.VarChar(24)
  settlementVerifiedAt DateTime?             @map("settlement_verified_at") @db.Timestamptz(3)
  logoMediaId          String?               @map("logo_media_id") @db.Uuid
  coverMediaId         String?               @map("cover_media_id") @db.Uuid
  themeColor           String?               @map("theme_color") @db.Char(7)
  status               String                @default("DRAFT") @db.VarChar(16)
  publishedAt          DateTime?             @map("published_at") @db.Timestamptz(3)
  publicationVersion   Int                   @default(0) @map("publication_version")
  revision             Int                   @default(0)
  returnPolicyRevision Int                   @default(0) @map("return_policy_revision")
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships          StoreMembership[]
  shippingMethods      StoreShippingMethod[]

  @@map("store_stores")
}

model StoreMembership {
  id       String @id @db.Uuid
  storeId  String @map("store_id") @db.Uuid
  sellerId String @map("seller_id") @db.Uuid
  role     String @default("OWNER") @db.VarChar(16)
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, sellerId])
  @@index([sellerId])
  @@map("store_memberships")
}

model StoreShippingMethod {
  id                      String @id @db.Uuid
  storeId                 String @map("store_id") @db.Uuid
  position                Int
  revision                Int    @default(1)
  code                    String @db.VarChar(32)
  label                   String @db.VarChar(60)
  fixedFeeAmount          BigInt @default(0) @map("fixed_fee_amount")
  currency                String @default("IRR") @db.Char(3)
  estimatedDeliveryText   String @default("زمان دقیق ارسال هنگام ثبت سفارش مشخص می‌شود.") @map("estimated_delivery_text") @db.VarChar(120)
  enabled                 Boolean @default(true)
  requiresDeliveryAddress Boolean @default(true) @map("requires_delivery_address")
  requiresPostalCode      Boolean @default(false) @map("requires_postal_code")
  store                   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, position])
  @@map("store_shipping_methods")
}

model StoreIdempotencyRecord {
  operation       String   @db.VarChar(80)
  actorIdentityId String   @map("actor_identity_id") @db.Uuid
  idempotencyKey  String   @map("idempotency_key") @db.VarChar(200)
  requestHash     String   @map("request_hash") @db.Char(64)
  responseJson    Json     @map("response_json") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([operation, actorIdentityId, idempotencyKey])
  @@map("store_idempotency_records")
}
