// Tables in this file are owned by the fulfillment module.

model FulfillmentOrder {
  orderId         String   @id @map("order_id") @db.Uuid
  storeId         String?  @map("store_id") @db.Uuid
  status          String   @db.VarChar(32)
  version         Int
  acceptedEventId String   @unique @map("accepted_event_id") @db.Uuid
  createdAt       DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(3)

  timeline FulfillmentTimelineEntry[]

  @@map("fulfillment_orders")
}

model FulfillmentTimelineEntry {
  id              String   @id @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  version         Int
  status          String   @db.VarChar(32)
  actorType       String   @map("actor_type") @db.VarChar(16)
  actorId         String?  @map("actor_id") @db.Uuid
  correlationId   String   @map("correlation_id") @db.Uuid
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(3)
  shippingMethod  String?  @map("shipping_method") @db.VarChar(80)
  trackingCode    String?  @map("tracking_code") @db.VarChar(100)

  order FulfillmentOrder @relation(fields: [orderId], references: [orderId])

  @@unique([orderId, version])
  @@index([orderId, occurredAt])
  @@map("fulfillment_timeline_entries")
}

model FulfillmentIdempotencyRecord {
  orderId       String   @map("order_id") @db.Uuid
  actorId       String   @map("actor_id") @db.Uuid
  key           String   @db.VarChar(128)
  requestHash   String   @map("request_hash") @db.Char(64)
  responseJson  Json     @map("response_json") @db.JsonB
  correlationId String   @map("correlation_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([orderId, actorId, key])
  @@map("fulfillment_idempotency_records")
}
