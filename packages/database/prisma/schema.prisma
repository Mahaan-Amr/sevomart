generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Seller {
  id        String   @id @db.Uuid
  mobile    String   @unique @db.VarChar(11)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions SellerSession[]

  @@map("identity_sellers")
}

model Store {
  id                   String                @id @db.Uuid
  name                 String?               @db.VarChar(80)
  slug                 String?               @unique @db.VarChar(48)
  bio                  String?               @db.VarChar(240)
  returnPolicy         String?               @map("return_policy") @db.VarChar(1000)
  settlementKind       String?               @map("settlement_kind") @db.VarChar(16)
  settlementStatus     String?               @map("settlement_status") @db.VarChar(24)
  settlementVerifiedAt DateTime?             @map("settlement_verified_at") @db.Timestamptz(3)
  logoMediaId          String?               @map("logo_media_id") @db.Uuid
  coverMediaId         String?               @map("cover_media_id") @db.Uuid
  themeColor           String?               @map("theme_color") @db.Char(7)
  status               String                @default("DRAFT") @db.VarChar(16)
  publishedAt          DateTime?             @map("published_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships          StoreMembership[]
  shippingMethods      StoreShippingMethod[]

  @@map("store_stores")
}

model StoreMembership {
  id       String @id @db.Uuid
  storeId  String @map("store_id") @db.Uuid
  sellerId String @map("seller_id") @db.Uuid
  role     String @default("OWNER") @db.VarChar(16)
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, sellerId])
  @@index([sellerId])
  @@map("store_memberships")
}

model StoreShippingMethod {
  id       String @id @db.Uuid
  storeId  String @map("store_id") @db.Uuid
  position Int
  code     String @db.VarChar(32)
  label    String @db.VarChar(60)
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, position])
  @@map("store_shipping_methods")
}

model OtpChallenge {
  id                String    @id @db.Uuid
  mobile            String    @db.VarChar(11)
  codeHash          String    @map("code_hash") @db.VarChar(64)
  providerReference String    @map("provider_reference") @db.VarChar(128)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([mobile, createdAt])
  @@map("identity_otp_challenges")
}

model SellerSession {
  id        String   @id @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  sellerId  String   @map("seller_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, expiresAt])
  @@map("identity_seller_sessions")
}
